@startuml
title Squad, people and authorization
hide methods
skinparam classAttributeIconSize 0
left to right direction

legend top
  Frontend/domain concept model, not an implementation or persistence design.
  Mirrors typespec/main.tsp.
endlegend

package "Squad, people and authorization" {
  class Squad {
    id: string
    name: string
    club?: string
    description?: string
    matchPlanningEnabled?: boolean
    createdAt?: DateTime
    updatedAt?: DateTime
  }

  class SfvCategory <<reference data>> {
    id: string
    code: string
    name: string
  }

  class OfficialMatchFormat <<reference data>> {
    id: string
    name: string
    playersOnField: integer
    minPlayersPerTeam: integer
    maxPlayersPerTeam: integer
    numberOfPeriods: integer
    periodLengthMinutes: integer
  }

  class SquadMembership {
    id: string
    roles: SquadRole[]
  }

  enum SquadRole {
    admin
    trainer
    guardian
    player
  }

  abstract class Person {
    id: string
    firstName: string
    lastName: string
    email?: string
    phone?: string
  }

  class Player {
    birthDate: Date
    level: integer (1..5)
    status: PlayerStatus
    preferredShirtNumber?: integer
  }

  enum PlayerStatus {
    active
    trial
    inactive
  }

  class Guardian {
    isDocumentedOnly?: boolean
  }

  class LoginAccount {
    id: string
    email: string
  }

  class Period {
    id: string
    name: string
    startDate: Date
    endDate: Date
  }

  Squad "1" *-- "0..*" SquadMembership : members
  SquadMembership "0..*" --> "1" Person : person
  Person <|-- Player
  Person <|-- Guardian
  Person "1" *-- "0..1" LoginAccount : optional login
  Player "0..*" -- "0..*" Guardian : guardians
  Squad "1" *-- "0..*" Period : statistics periods
  Squad "0..*" --> "0..1" SfvCategory : category
  SfvCategory "1" *-- "0..*" OfficialMatchFormat : official formats
}

note right of SquadMembership
  The Squad's `trainer` role is official Trainer
  authorization. It is distinct from a
  TrainingSession trainer or a Team's responsible
  person. A person may hold multiple Squad roles.
  Persons are global, not owned by a Squad.
end note

note right of SfvCategory
  Chosen when a Squad is created. Its official
  match formats are copied into the Squad's
  MatchFormats.
end note

@enduml

@startuml
title Scheduled activities and participation
hide methods
skinparam classAttributeIconSize 0
left to right direction

legend top
  Frontend/domain concept model, not an implementation or persistence design.
  Shared activity, invitation, attendance, task and history properties.
endlegend

class Squad
abstract class Person

abstract class ScheduledActivity {
  id: string
  name: string
  startsAt: DateTime
  endsAt?: DateTime
  location?: string
  /isCompleted: boolean
}

abstract class CompetitiveActivity {
  minPlayersPerTeam: integer
  maxPlayersPerTeam: integer
  selectionSentAt?: DateTime
}

class Match {
  opponentName?: string
}

class Tournament
class TrainingSession
class SocialEvent
class MatchFormat

class Invitation {
  id: string
  response: InvitationResponse
  declineReason?: InvitationReason
  respondedAt?: DateTime
}

enum InvitationResponse {
  open
  accepted
  declined
}

enum InvitationReason {
  sick
  injured
  unavailable
}

class Attendance {
  id: string
  status: AttendanceStatus
}

enum AttendanceStatus {
  present
  absent
  excused
}

class ActivityTask {
  id: string
  name: string
  description?: string
  requiredPeople: integer (>= 1)
  /isFulfilled: boolean
}

class TaskSignup {
  id: string
  signedUpAt: DateTime
}

class ActivityHistoryItem <<frontend history view>> {
  occurredAt: DateTime
  action: string
  summary: string
}

ScheduledActivity <|-- CompetitiveActivity
ScheduledActivity <|-- TrainingSession
ScheduledActivity <|-- SocialEvent
CompetitiveActivity <|-- Match
CompetitiveActivity <|-- Tournament
Squad "1" *-- "0..*" ScheduledActivity : activities; deleting Squad deletes them
CompetitiveActivity "0..*" --> "0..1" MatchFormat : matchFormat
TrainingSession "0..*" --> "1..*" Person : trainers
ScheduledActivity "1" *-- "0..*" Invitation : invitations
Invitation "0..*" --> "1" Person : person
Invitation "0..*" --> "0..1" Person : respondedBy
ScheduledActivity "1" *-- "0..*" Attendance : attendance
Attendance "0..*" --> "1" Person : person
ScheduledActivity "1" *-- "0..*" ActivityTask : tasks
ActivityTask "1" *-- "0..*" TaskSignup : signups
TaskSignup "0..*" --> "1" Person : person
ScheduledActivity "1" *-- "0..*" ActivityHistoryItem : history
ActivityHistoryItem "0..*" --> "1" Person : actor

note right of ScheduledActivity
  Common schedule/location is activity-level.
  `isCompleted` is derived from the activity
  being in the past; there is no stored lifecycle
  status. Cancellation is out of scope.
end note

note right of Invitation
  `declineReason` is only valid for declined
  responses. Invitation send time is out of scope.
end note

note right of Attendance
  Recorded after the activity. Never inferred from
  acceptance or selection.
end note

note right of ActivityTask
  Free-form helper task (e.g. Kiosk, set up goals)
  created by a Squad Trainer for one activity.
  Players and Guardians sign up; trainers may sign
  people up too. `isFulfilled` when signups reach
  `requiredPeople`. Never belongs to a Team.
end note

note right of TrainingSession
  Needs one or more trainers. They need not have
  official Squad Trainer authorization.
end note

note bottom of CompetitiveActivity
  Limits apply to every Team in the activity.
  `matchFormat` pre-fills the limits; they remain
  overridable. `selectionSentAt` is the most recent
  time the selection was communicated. Selected
  players must have accepted and may be in at most
  one Team of the same activity.
end note

note right of SocialEvent
  SocialEvent has no Teams.
end note
@enduml

@startuml
title Match and Tournament teams, planning and shirts
hide methods
skinparam classAttributeIconSize 0
left to right direction

legend top
  Team selection, match planning and reusable shirts.
endlegend

class Squad
class Person
class Player
class Match
class Tournament
abstract class CompetitiveActivity
class SfvCategory
class OfficialMatchFormat

class Team {
  id: string
  name: string
  strength?: integer (1..3)
  startTime?: Time
  location?: string
}

class MatchFormat {
  id: string
  name: string
  playersOnField: integer
  minPlayersPerTeam: integer
  maxPlayersPerTeam: integer
  numberOfPeriods: integer
  periodLengthMinutes: integer
  minimumPeriodsPerPlayer?: integer
  isDefault?: boolean
}

class Formation {
  id: string
  name: string
}

class FormationSlot {
  id: string
  positionCode: PositionCode
}

enum PositionCode {
  GK
  LB
  CB
  RB
  LWB
  RWB
  CDM
  CM
  CAM
  LM
  RM
  LW
  RW
  CF
  ST
}

class MatchPlan

class TeamLineupPeriod {
  periodNumber: integer
}

class LineupPositionAssignment

class ShirtSet {
  id: string
  sponsor: string
  color: string
}

class Shirt {
  id: string
  number: integer
  size: ShirtSize
  isGoalkeeper: boolean
  status?: ShirtStatus
}

enum ShirtSize {
  "128"
  "140"
  "152"
  "164"
  XS
  S
  M
  L
  XL
}

enum ShirtStatus {
  available
  unavailable
}

class ShirtAssignment

CompetitiveActivity <|-- Match
CompetitiveActivity <|-- Tournament
Match "1" *-- "1" Team : team
Tournament "1" *-- "1..*" Team : teams
Team "0..*" --> "0..*" Player : selectedPlayers
Team "0..*" --> "1..*" Person : responsiblePersons

Squad "1" *-- "0..*" MatchFormat : matchFormats
Squad "1" *-- "0..*" Formation : formations
MatchFormat "0..*" --> "0..1" OfficialMatchFormat : origin
Formation "1" *-- "1..*" FormationSlot : slots
Team "1" *-- "0..1" MatchPlan : Match only
MatchPlan "0..*" --> "1" Formation : formation
MatchPlan "1" *-- "0..*" TeamLineupPeriod : periods
TeamLineupPeriod "1" *-- "0..*" LineupPositionAssignment : assignments
LineupPositionAssignment "0..*" --> "1" Player : player
LineupPositionAssignment "0..*" --> "1" FormationSlot : slot

Squad "1" *-- "0..*" ShirtSet : shirtSets
ShirtSet "1" *-- "0..*" Shirt : shirts
Team "0..*" --> "0..1" ShirtSet : shirtSet
Team "1" *-- "0..*" ShirtAssignment : shirtAssignments
ShirtAssignment "0..*" --> "1" Player : player
ShirtAssignment "0..*" --> "1" Shirt : shirt

note right of Team
  Match has exactly one Team; Tournament has one
  or more. A Team is a selection in one activity,
  not a permanent club team. It needs at least one
  responsible person (not necessarily a Squad
  Trainer). `strength` defaults to 2 and balances
  Tournament teams. `startTime` / `location` are
  optional Tournament overrides of the activity.
end note

note bottom of Match
  The opponent is only a label. The lineup (MatchPlan)
  is Match-only; Tournament fixtures and lineups are
  not modeled.
end note

note bottom of MatchFormat
  Copied from an OfficialMatchFormat on Squad
  creation (`origin` set) or user-defined.
  At most one default per Squad.
end note

note bottom of Formation
  Exactly one GK slot and at least one outfield slot.
  Match-planning configuration only applies when
  the Squad has `matchPlanningEnabled`.
end note

@enduml

@startuml
title Training session groupings
hide methods
skinparam classAttributeIconSize 0
left to right direction

legend top
  Training grouping properties and their relationship to accepted players.
endlegend

class TrainingSession
class Player

class TrainingGroup {
  id: string
  name: string
  levelOrPurpose?: string
}

class TrainingUnit {
  id: string
  name: string
}

TrainingSession "1" *-- "0..*" TrainingGroup : subgroups
TrainingGroup "1" *-- "0..*" TrainingUnit : units
TrainingUnit "0..*" --> "0..*" Player : plannedPlayers

note bottom of TrainingUnit
  Example: 24 accepted players -> 2 groups
  -> 3 units of 4 players per group.
  Planned from accepted invitations. Ad-hoc
  regrouping is not retained; only general
  post-session attendance is recorded.
end note

@enduml
